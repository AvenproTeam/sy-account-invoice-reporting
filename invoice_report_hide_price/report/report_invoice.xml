<odoo>
    <template
        id="invoice_report_hide_price_report_invoice_document"
        name="invoice.report.hide.price.report.invoice.document"
        inherit_id="account.report_invoice_document"
    >
        <!-- Header columns: unit price and subtotal -->
        <xpath expr="//th[@name='th_priceunit']" position="attributes">
            <attribute name="t-if">o.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-if">display_discount and o.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="t-if">o.has_show_price_report_lines</attribute>
        </xpath>
        <!-- Line cells: unit price, discount, subtotal -->
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[@name='td_price_unit']" position="attributes">
            <attribute name="t-if">o.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[@name='td_discount']" position="attributes">
            <attribute name="t-if">display_discount and o.has_show_price_report_lines</attribute>
        </xpath>
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[@name='td_subtotal']" position="attributes">
            <attribute name="t-if">o.has_show_price_report_lines</attribute>
        </xpath>
        <!-- Per-line visibility -->
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.discount']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-if">line.show_price_info_report</attribute>
        </xpath>
    </template>
</odoo>
